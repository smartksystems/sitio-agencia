---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { wa } from '../config/site';
import { SERVICES } from '../data/content';
---
<Layout
  title="Servicios de diseño web y marketing digital | SMART K SYSTEMS"
  description="Identidad corporativa digital con páginas web a medida y marketing digital para posicionar tu negocio sobre la competencia. Conoce los servicios de Agencia SKS."
>
  <PageHeader title="Servicios" lead="Implementamos estrategias digitales inteligentes que ayudan a los negocios a atraer clientes, automatizar procesos y crecer con tecnología." />
  <section class="py-20">
    <div class="container-x space-y-8">
      {SERVICES.map((s) => (
        <article class="grid items-center gap-6 rounded-2xl bg-paper p-8 md:grid-cols-[8rem_1fr]">
          <img src={s.img} alt={s.alt} width="128" height="128" loading="lazy" class="h-24 w-24 md:h-32 md:w-32" />
          <div>
            <h2 class="text-2xl font-bold">{s.title}</h2>
            <p class="mt-3 max-w-prose text-slate-600">{s.text}</p>
            <a href={wa(`Hola Smart K Systems, me interesa ${s.title}.`)} class="btn-brand mt-5">Cotizar este servicio</a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Layout>
