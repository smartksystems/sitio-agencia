---
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '../styles/global.css';
const { title = 'SMART K SYSTEMS | Sistemas digitales inteligentes para tu negocio', description = 'Diseño web, marketing digital, automatización e inteligencia artificial para negocios. Solicita una asesoría gratuita con Agencia SKS.' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'SMART K SYSTEMS (Agencia SKS)',
  url: 'https://agenciasks.com',
  email: 'ventas@agenciasks.com',
  telephone: '+593960111702',
  description,
  sameAs: ['https://www.facebook.com/smartksystems/', 'https://www.instagram.com/sks.agencia/', 'https://www.linkedin.com/company/sks-agency/'],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07152f" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-white focus:p-3">Saltar al contenido</a>
    <slot />
  </body>
</html>
