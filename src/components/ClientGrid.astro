---
import { CLIENTS } from '../data/content';
---
<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
  {CLIENTS.map((c) => (
    <li>
      <a href={c.url} target="_blank" rel="noopener" class="flex h-28 items-center justify-center rounded-xl border border-slate-200 bg-white p-4 hover:border-brand">
        <img src={c.img} alt={c.alt} width="200" height="80" loading="lazy" decoding="async" class="max-h-full w-auto object-contain" />
        <span class="sr-only">Visitar {c.name}</span>
      </a>
    </li>
  ))}
</ul>
