---
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<section class="grid-bg bg-ink text-white">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:py-24">
    <h1 class="max-w-4xl text-4xl font-bold leading-[1.1] sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-slate-300">{lead}</p>}
    <slot />
  </div>
</section>
