---
import { SITE, HOURS, WA, NAV } from '../config/site';
---
<footer class="bg-ink text-slate-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src={SITE.logo} alt={`Logotipo de ${SITE.name}`} width="48" height="48" loading="lazy" class="h-12 w-12 rounded-md" />
      <p class="mt-4 font-display font-bold text-white">{SITE.name}</p>
      <p class="mt-1 text-sm">Sistemas digitales inteligentes para hacer crecer tu negocio.</p>
    </div>
    <nav aria-label="Enlaces directos">
      <p class="font-bold text-white">Enlaces directos</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.filter((n) => n.label !== 'Sobre nosotros').map((n) => <li><a class="hover:text-cta" href={n.href}>{n.label}</a></li>)}
        <li><a class="hover:text-cta" href="/sobre-nosotros/trabaja-con-nosotros/">Trabaja con nosotros</a></li>
      </ul>
    </nav>
    <div>
      <p class="font-bold text-white">Horarios</p>
      <ul class="mt-3 space-y-3 text-sm">
        {HOURS.map((h) => <li>{h.days}<br /><span class="text-white">{h.time}</span></li>)}
      </ul>
    </div>
    <div class="text-sm">
      <p class="font-bold text-white">Contacto directo</p>
      <p class="mt-3"><a class="hover:text-cta" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="mt-1"><a class="hover:text-cta" href={WA.advice}>{SITE.phoneDisplay}</a></p>
      <p class="mt-5 font-bold text-white">Nuestras redes</p>
      <ul class="mt-3 space-y-1">
        {SITE.social.map((s) => <li><a class="hover:text-cta" rel="noopener" href={s.url}>{s.name}: {s.handle}</a></li>)}
      </ul>
    </div>
  </div>
  <p class="border-t border-white/10 py-5 text-center text-sm text-slate-400">{SITE.founded} | {SITE.short}</p>
</footer>
